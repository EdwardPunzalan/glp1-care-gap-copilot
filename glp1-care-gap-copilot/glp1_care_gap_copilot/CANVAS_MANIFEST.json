{
    "sdk_version": "0.1.4",
    "plugin_version": "2.4.1",
    "name": "glp1_care_gap_copilot",
    "description": "Surfaces GLP-1 monitoring care gaps (stale weight, overdue labs, missing follow-up) as a protocol card with one-click, clinician-reviewed actions, plus a chart summary weight-trend graph and a safety rule that raises a chart banner when rapid weight loss coincides with a clinical warning sign.",
    "components": {
        "handlers": [
            {
                "class": "glp1_care_gap_copilot.handlers.care_gap_handler:GLP1CareGapHandler",
                "description": "Computes GLP-1 care gaps when a note or patient chart is opened and upserts a protocol card."
            },
            {
                "class": "glp1_care_gap_copilot.handlers.weight_trend_handler:GLP1WeightTrendSection",
                "description": "Serves the weight-trend graph into its custom patient chart summary section."
            },
            {
                "class": "glp1_care_gap_copilot.handlers.weight_trend_handler:GLP1ChartSummaryConfiguration",
                "description": "Declares the patient chart summary layout so the weight-trend section appears."
            },
            {
                "class": "glp1_care_gap_copilot.handlers.weight_trend_handler:GLP1WeightTrendButton",
                "description": "Patient-header button that opens the weight-trend graph full size in a modal."
            },
            {
                "class": "glp1_care_gap_copilot.handlers.alert_scan_handler:GLP1AlertScan",
                "description": "Nightly scan that files GLP-1 safety alerts as tasks for patients weighed recently."
            },
            {
                "class": "glp1_care_gap_copilot.handlers.hub_handler:GLP1HubAPI",
                "description": "Serves the GLP-1 monitoring hub page, files tasks its buttons request, and runs the safety scan on demand."
            }
        ],
        "commands": [],
        "content": [],
        "effects": [],
        "views": [],
        "questionnaires": [
            {
                "template": "templates/glp1_safety_check.yml"
            }
        ],
        "applications": [
            {
                "class": "glp1_care_gap_copilot.handlers.hub_handler:GLP1Hub",
                "name": "GLP-1 Monitoring",
                "description": "Every GLP-1 patient on one page, high risk first.",
                "icon": "assets/alerts-icon.png",
                "scope": "global"
            }
        ]
    },
    "variables": [
        {
            "name": "WEIGHT_CHECK_INTERVAL_DAYS"
        },
        {
            "name": "LAB_INTERVAL_DAYS"
        },
        {
            "name": "HIGH_CHOLESTEROL_ICD10_PREFIXES"
        },
        {
            "name": "PREDIABETES_ICD10_PREFIXES"
        },
        {
            "name": "HYPOTHYROID_ICD10_PREFIXES"
        },
        {
            "name": "GLP1_MIN_DAYS_FOR_LABS"
        },
        {
            "name": "LAB_INTERVAL_OBESITY_ONLY_DAYS"
        },
        {
            "name": "FOLLOWUP_HORIZON_DAYS"
        },
        {
            "name": "GLP1_MED_NAME_FRAGMENTS"
        },
        {
            "name": "OBESITY_ICD10_PREFIXES"
        },
        {
            "name": "DIABETES_ICD10_PREFIXES"
        },
        {
            "name": "OUTREACH_TEAM_DBID"
        },
        {
            "name": "LAB_PARTNER_NAME"
        },
        {
            "name": "LAB_TEST_ORDER_CODES"
        },
        {
            "name": "TASK_TITLE_PREFIX"
        },
        {
            "name": "WEIGHT_TREND_POINTS"
        },
        {
            "name": "WEIGHT_DROP_ALERT_LB"
        },
        {
            "name": "WEIGHT_DROP_MAX_INTERVAL_DAYS"
        },
        {
            "name": "SAFETY_WINDOW_DAYS"
        },
        {
            "name": "SAFETY_MIN_FINDINGS"
        },
        {
            "name": "ALERT_SCAN_LOOKBACK_DAYS"
        },
        {
            "name": "ALERT_SCAN_MAX_PATIENTS"
        },
        {
            "name": "HUB_MAX_PATIENTS"
        },
        {
            "name": "HUB_WEIGHT_DAYS"
        }
    ],
    "tags": {},
    "references": [],
    "license": "",
    "diagram": false,
    "readme": "./README.md"
}
